@model Page<MemberProfile>
@{ ViewData["Title"] = "My clients"; }
<div class="page-heading"><div><span class="eyebrow">PEOPLE, BEFORE NUMBERS</span><h1>My clients</h1><p>Support the people currently assigned to you.</p></div><span class="date-chip">@Model.Total clients</span></div>
<section class="panel"><form method="get" class="filters"><div><label for="search">Find a client</label><input field-feedback id="search" name="search" value="@ViewData["Search"]" placeholder="Search by name" /></div><button class="btn btn-secondary">Search</button></form>@if (Model.Total == 0) { <div class="empty"><p>No assigned clients match. An administrator can manage assignments.</p></div> }<div class="member-grid">@foreach (var person in Model.Items) { <a class="member-card" asp-action="Client" asp-route-id="@person.UserId"><span class="avatar large">@person.DisplayName[..1]</span><h2>@person.DisplayName</h2><p>@(string.IsNullOrWhiteSpace(person.Bio) ? "Ready for your support" : person.Bio)</p><span>View progress & plans →</span></a> }</div><partial name="_Pager" model="@((Model.Number, Model.Pages))" /></section>
