@model ProgressReport
@{ ViewData["Title"] = Model.Name; }
<div class="page-heading"><div><span class="eyebrow">YOUR ASSIGNED CLIENT</span><h1>@Model.Name</h1><p>Progress over the past 30 days.</p></div><a href="/Trainer/Clients">All clients →</a></div><div class="actions toolbar"><a class="btn btn-primary" href="/Plans/Edit?clientId=@Model.ClientId&kind=Workout">+ Workout plan</a><a class="btn btn-outline-secondary" href="/Plans/Edit?clientId=@Model.ClientId&kind=Diet">+ Diet plan</a><a class="btn btn-outline-secondary" href="/Plans?clientId=@Model.ClientId">View plans</a><a href="/Progress?clientId=@Model.ClientId">Detailed report →</a></div><partial name="~/Views/Shared/_Progress.cshtml" model="Model" /><section class="panel form-panel"><h2>A note of support</h2><p>Share feedback with this client. It will appear on their dashboard.</p><form method="post" asp-action="Feedback"><input name="clientId" type="hidden" value="@Model.ClientId" /><label for="comment">Your feedback</label><textarea field-feedback id="comment" name="comment" maxlength="2000" rows="4" required></textarea><button class="btn btn-primary">Share feedback</button></form></section>
