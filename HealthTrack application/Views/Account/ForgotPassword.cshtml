@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
    var requested = ViewData["Sent"] is true;
}
<div class="auth-recovery">
    <span class="auth-recovery-label">ACCOUNT RECOVERY</span>
    @if (requested)
    {
        <div role="status" class="auth-recovery-result">
            <h1>Request received</h1>
            <p class="auth-intro">If your email matches an eligible account, a reset link can be provided by your app administrator when local recovery is enabled.</p>
        </div>
        <div class="auth-recovery-note">
            <img src="~/lib/auth-icons/envelope.svg" alt="" width="22" height="22" />
            <div><h2>Your next step</h2><p>Ask your app administrator for the reset link. This local version does not send recovery emails.</p></div>
        </div>
        <a class="auth-submit auth-recovery-action" asp-action="Login">Back to sign in</a>
        <p class="auth-switch">Entered the wrong email? <a asp-action="ForgotPassword">Try again</a></p>
    }
    else
    {
        <h1>Forgot your password?</h1>
        <p class="auth-intro">Let's get you back to your routine. Enter your account email to request a password reset link.</p>
        <form method="post" class="auth-form" aria-label="Request a password reset">
            
            <div class="auth-field">
                <label for="email">Email address</label>
                <div class="auth-input-wrap">
                    <img class="auth-input-icon" src="~/lib/auth-icons/envelope.svg" alt="" />
                    <input id="email" name="email" type="email" value="@(ViewData.ModelState["email"]?.AttemptedValue)" autocomplete="email" inputmode="email" maxlength="256" required placeholder="Enter your email" aria-describedby="recovery-email-hint email-error" aria-invalid="@(ViewData.ModelState["email"]?.Errors.Count > 0 ? "true" : "false")" />
                </div>
                <span class="auth-hint" id="recovery-email-hint">Use the email address you signed up with.</span>
                @Html.ValidationMessage("email", null, new { id = "email-error", role = "alert" })
            </div>
            <button class="auth-submit" type="submit">Request reset link</button>
        </form>
        <div class="auth-recovery-note">
            <img src="~/lib/auth-icons/lock.svg" alt="" width="22" height="22" />
            <div><h2>How you'll receive your link</h2><p>Reset links are provided by your app administrator in this local version. Recovery emails are not sent.</p></div>
        </div>
        <p class="auth-switch">Remember your password? <a asp-action="Login">Back to sign in</a></p>
    }
    <p class="auth-recovery-help">Need a hand? <a asp-controller="Home" asp-action="Contact">Contact us</a></p>
</div>
