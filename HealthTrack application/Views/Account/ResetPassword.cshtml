@model ResetInput
@{ ViewData["Title"] = "Choose a new password"; }
<section class="panel form-panel"><h1>Choose a new password</h1><form method="post"><input asp-for="Token" type="hidden" /><label asp-for="Email"></label><input field-feedback asp-for="Email" /><label asp-for="Password">New password</label><input field-feedback asp-for="Password" autocomplete="new-password" /><label asp-for="ConfirmPassword">Confirm password</label><input field-feedback asp-for="ConfirmPassword" autocomplete="new-password" /><button class="btn btn-primary">Reset password</button></form></section>
