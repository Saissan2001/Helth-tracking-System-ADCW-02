@model HealthPlan
@{ ViewData["Title"] = Model.Title; var trainer = User.IsInRole(Roles.Trainer); }
<div class="page-heading"><div><span class="eyebrow">@Model.Kind PLAN · @Model.Status</span><h1>@Model.Title</h1><p>@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</p></div><a asp-action="Index">All plans →</a></div>
<section class="panel"><p class="preserve-lines">@Model.Instructions</p>@if (trainer) { <div class="actions">@if (Model.Status == PlanStatus.Draft) { <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit details</a><form method="post" asp-action="Change"><input name="id" type="hidden" value="@Model.Id" /><input name="version" type="hidden" value="@Display.Version(Model)" /><input name="status" type="hidden" value="Published" /><button class="btn btn-primary">Publish plan →</button></form> } @if (Model.Status == PlanStatus.Published) { <form method="post" asp-action="Change" data-confirm="Archive this plan? It will no longer appear in the client's active plans."><input name="id" type="hidden" value="@Model.Id" /><input name="version" type="hidden" value="@Display.Version(Model)" /><input name="status" type="hidden" value="Archived" /><button class="btn btn-outline-secondary">Archive plan</button></form><p class="muted">To revise a published schedule, create a new draft and archive this version.</p> }</div> }</section>
<section class="panel"><div class="panel-heading"><h2>Your weekly schedule</h2><span class="pill">CLIENT'S LOCAL TIME</span></div>@if (Model.Items.Count == 0) { <div class="empty"><p>Add at least one exercise or meal before publishing.</p></div> }
@foreach (var day in Model.Items.GroupBy(x => x.Day).OrderBy(x => ((int)x.Key + 6) % 7)) { <h3 class="day-heading">@day.Key</h3>@foreach (var item in day.OrderBy(x => x.LocalTime)) { <div class="schedule-row"><time>@item.LocalTime.ToString("HH:mm")</time><div><strong>@item.Description</strong><small>@if (Model.Kind == PlanKind.Workout) { <span>@(item.Sets.HasValue ? $"{item.Sets} sets × {item.Repetitions} reps · " : "")@(item.DurationMinutes.HasValue ? $"{item.DurationMinutes} min" : "")</span> } else { <span>@item.MealType · @(item.Calories?.ToString("0.#") ?? "—") kcal · P @(item.Protein?.ToString() ?? "—") / C @(item.Carbs?.ToString() ?? "—") / F @(item.Fat?.ToString() ?? "—") g</span> }</small></div>@if (trainer && Model.Status == PlanStatus.Draft) { <form method="post" asp-action="RemoveItem" data-confirm="Remove this schedule item?"><input name="id" type="hidden" value="@item.Id" /><input name="planId" type="hidden" value="@Model.Id" /><input name="version" type="hidden" value="@Display.Version(Model)" /><button class="link-danger">Remove</button></form> }</div> } }</section>
@if (trainer && Model.Status == PlanStatus.Draft) {
<section class="panel form-panel"><h2>Add @(Model.Kind == PlanKind.Workout ? "an exercise" : "a meal")</h2><form method="post" asp-action="AddItem"><input name="PlanId" type="hidden" value="@Model.Id" /><input name="Version" type="hidden" value="@Display.Version(Model)" /><div class="form-grid"><div><label for="Day">Day of week</label><select field-feedback id="Day" name="Day" asp-items="Html.GetEnumSelectList<DayOfWeek>()"></select></div><div><label for="LocalTime">Time</label><input field-feedback id="LocalTime" name="LocalTime" type="time" value="08:00" required /></div></div><label for="Description">@(Model.Kind == PlanKind.Workout ? "Exercise and guidance" : "Food description")</label><input field-feedback id="Description" name="Description" maxlength="250" required /><div class="form-grid">
@if (Model.Kind == PlanKind.Workout) { <div><label for="Routine">Routine category</label><select field-feedback id="Routine" name="Routine" asp-items="Html.GetEnumSelectList<WorkoutRoutine>()"></select></div><div><label for="Sets">Sets</label><input field-feedback id="Sets" name="Sets" type="number" min="1" max="100" /></div><div><label for="Repetitions">Repetitions</label><input field-feedback id="Repetitions" name="Repetitions" type="number" min="1" max="1000" /></div><div><label for="DurationMinutes">Duration (minutes)</label><input field-feedback id="DurationMinutes" name="DurationMinutes" type="number" min="1" max="1440" /></div> }
else { <div><label for="MealType">Meal type</label><select field-feedback id="MealType" name="MealType"><option>Breakfast</option><option>Lunch</option><option>Dinner</option><option>Snack</option></select></div><div><label for="Calories">Energy (kcal, optional)</label><input field-feedback id="Calories" name="Calories" type="number" min="0" max="30000" step="0.1" /></div>@foreach (var nutrient in new[] { "Protein", "Carbs", "Fat" }) { <div><label for="@nutrient">@nutrient (g, optional)</label><input field-feedback id="@nutrient" name="@nutrient" type="number" min="0" max="5000" step="0.1" /></div> } }</div><button class="btn btn-primary">+ Add to schedule</button></form></section>
}

@if (Model.Status != PlanStatus.Draft) { <section class="panel"><h2>Plan progress</h2><p>See scheduled occurrences and the actual entries linked to each one.</p><a class="btn btn-primary" asp-action="Adherence" asp-route-id="@Model.Id">View completion history</a></section> }
