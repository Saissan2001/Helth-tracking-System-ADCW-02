@model Page<HealthPlan>
@{ ViewData["Title"] = User.IsInRole(Roles.Client) ? "My plans" : "Training & diet plans"; }
<div class="page-heading"><div><span class="eyebrow">GUIDANCE FOR YOUR EVERYDAY</span><h1>@ViewData["Title"]</h1><p>@(User.IsInRole(Roles.Client) ? "Published and archived schedules from your trainer. Open plan progress to record completed workouts or meals." : "Build a draft, add a weekly schedule, then publish for your client.")</p></div>@if (User.IsInRole(Roles.Trainer)) { <a class="btn btn-primary" href="/Trainer/Clients">+ Create for a client</a> }</div>
<div class="tabs"><a asp-action="Index" asp-route-clientId="@ViewData["ClientId"]">All plans</a><a asp-action="Index" asp-route-kind="Workout" asp-route-clientId="@ViewData["ClientId"]">Workouts</a><a asp-action="Index" asp-route-kind="Diet" asp-route-clientId="@ViewData["ClientId"]">Nutrition</a></div>
@if (Model.Total == 0) { <section class="panel empty"><span>▤</span><h2>No plans here yet.</h2><p>@(User.IsInRole(Roles.Client) ? "Your trainer's published plans will appear here." : "Open an assigned client to create their first plan.")</p></section> }
<div class="feature-grid">@foreach (var plan in Model.Items) { <article class="panel plan-card"><div class="panel-heading"><span class="feature-icon">@(plan.Kind == PlanKind.Workout ? "↗" : "◒")</span><span class="status">@plan.Status</span></div><span class="eyebrow">@plan.Kind PLAN</span><h2>@plan.Title</h2><p>@plan.Instructions</p><small>@plan.StartDate.ToString("dd MMM yyyy") – @plan.EndDate.ToString("dd MMM yyyy")</small><div class="plan-card-footer"><span>@plan.Items.Count schedule items</span><a asp-action="Details" asp-route-id="@plan.Id">Open plan →</a></div></article> }</div><partial name="_Pager" model="@((Model.Number, Model.Pages))" />
