@model Page<HealthLog>
@{ ViewData["Title"] = "Saved entries"; }
<div class="page-heading"><div><h1>Keep the familiar things close</h1><p>Reusable meals and workouts from your own diary. Review every copy before logging it.</p></div><a class="btn btn-outline-secondary" href="/Wellness">Back to diary</a></div>
@if (Model.Total == 0) { <section class="panel empty"><h2>Your saved library starts in your diary</h2><p>Choose “Save for reuse” on a meal or workout. Next time, you can check the details and log it again without typing everything from scratch.</p><a class="btn btn-primary" href="/Wellness">Open diary</a></section> }
else { <div class="library-grid">@foreach (var entry in Model.Items) { <article class="panel library-card"><span class="status">@entry.Kind</span><h2>@entry.Description</h2><p>@(entry.Kind == LogKind.Workout ? $"{entry.DurationMinutes} minutes · {entry.Routine}" : Display.Number(entry.Calories, " kcal"))</p>@if (entry.Kind == LogKind.Meal) { <p>Protein @Display.Number(entry.Protein, "g") · Carbs @Display.Number(entry.Carbs, "g") · Fat @Display.Number(entry.Fat, "g")</p> }<div class="actions"><a class="btn btn-primary" asp-controller="Logs" asp-action="Edit" asp-route-repeatId="@entry.Id" asp-route-returnUrl="/Wellness">Review & log again</a><form method="post" asp-action="Favorite"><input type="hidden" name="id" value="@entry.Id" /><input type="hidden" name="version" value="@Display.Version(entry)" /><input type="hidden" name="favorite" value="false" /><button class="link-button">Remove from saved</button></form></div></article> }</div><partial name="_Pager" model="@((Model.Number, Model.Pages))" /> }
<p class="muted">Saved entries are references to existing logs. Removing from saved keeps the original log; deleting the original log removes its saved shortcut. Up to 100 entries can be saved.</p>
