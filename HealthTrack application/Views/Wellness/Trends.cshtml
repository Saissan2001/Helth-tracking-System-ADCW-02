@model DailyOverview
@{ ViewData["Title"] = "Wellness trends"; var waterDays = Model.Days.Where(x => x.WaterMl.HasValue).ToList(); var sleepDays = Model.Days.Where(x => x.SleepMinutes.HasValue).ToList(); }
<div class="page-heading"><div><h1>A clearer view of your week</h1><p>@Model.Days.First().Date.ToString("dd MMM") – @Model.Date.ToString("dd MMM yyyy") · @Model.Profile.TimeZoneId</p></div><a class="btn btn-primary" asp-action="Export" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">Download this week</a></div>
<section class="panel"><form method="get" class="diary-datebar"><label for="date">Week ending</label><input field-feedback id="date" name="date" type="date" min="@Model.Today.AddYears(-10).ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Date.ToString("yyyy-MM-dd")" required /><button class="btn btn-primary">View week</button><a href="/Wellness/Trends">Latest week</a></form></section>
<div class="wellness-metrics"><article class="wellness-metric metric-movement"><span>Workout minutes</span><strong>@Model.SevenWorkoutMinutes</strong><p>Previous seven days: @Model.PreviousSevenMinutes</p><small>Compare recorded activity, not estimated fitness.</small></article><article class="wellness-metric metric-water"><span>Average water on recorded days</span><strong>@(waterDays.Count == 0 ? "—" : waterDays.Average(x => x.WaterMl!.Value).ToString("N0")) <span>ml</span></strong><p>@waterDays.Count of 7 days have water entries</p></article><article class="wellness-metric metric-sleep"><span>Average sleep on recorded days</span><strong>@(sleepDays.Count == 0 ? "—" : (sleepDays.Average(x => x.SleepMinutes!.Value) / 60).ToString("0.0")) <span>hours</span></strong><p>@sleepDays.Count of 7 wake-up dates recorded</p></article><article class="wellness-metric metric-steps"><span>Days with an entry</span><strong>@Model.RecordedDays <span>/ 7</span></strong><p>Previous seven days: @Model.PreviousSevenRecordedDays</p></article></div>
<section class="panel"><h2>Movement, water and rest</h2><p>Choose a metric to see its own units. Missing water and sleep data appear as gaps, not zero.</p><div class="wellness-chart-selector"><label for="wellness-metric">Chart metric</label><select id="wellness-metric"><option value="WorkoutMinutes">Workout minutes</option><option value="WaterMl">Water (ml)</option><option value="SleepMinutes">Sleep (minutes)</option><option value="Steps">Latest daily steps</option></select></div><div class="chart-wrap"><canvas class="wellness-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Days)" role="img" aria-label="Seven-day wellness chart. Exact values are in the following table."></canvas></div><div class="table-responsive"><table><caption>Daily totals in @Model.Profile.TimeZoneId. A dash means not recorded.</caption><thead><tr><th>Date</th><th>Workouts / minutes</th><th>Water (ml)</th><th>Sleep (minutes)</th><th>Steps</th><th>Known meal kcal</th></tr></thead><tbody>@foreach (var day in Model.Days) { <tr><td><a href="/Wellness?date=@day.Date.ToString("yyyy-MM-dd")">@day.Date.ToString("dd MMM")</a></td><td>@day.WorkoutCount / @day.WorkoutMinutes</td><td>@(day.WaterMl?.ToString("N0") ?? "—")</td><td>@(day.SleepMinutes?.ToString() ?? "—")</td><td>@(day.Steps?.ToString("N0") ?? "—")</td><td>@Display.Number(day.MealCalories)@if (day.MealsMissingCalories > 0) { <small class="table-note">@day.MealsMissingCalories meals without calories</small> }</td></tr> }</tbody></table></div></section>
<section class="panel"><h2>How to read your trends</h2><p>Averages include only days with that metric recorded. Sleep uses wake-up dates; steps use the latest daily reading. Partial logs can make comparisons incomplete. These summaries describe your entries and do not diagnose a condition or estimate a readiness score.</p><a href="/Progress">Open weight, BMI and activity analytics</a></section>
