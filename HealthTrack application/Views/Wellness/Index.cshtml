@model DailyOverview
@{ ViewData["Title"] = "Daily diary"; var returnUrl = $"/Wellness?date={Model.Date:yyyy-MM-dd}&page={Model.Entries.Number}"; }
<div class="page-heading"><div><h1>Your daily diary</h1><p>Everything you recorded, together. Times use @Model.Profile.TimeZoneId.</p></div><a class="btn btn-outline-secondary" href="/Wellness/Library">Saved entries</a></div>
<section class="panel diary-datebar">@if (Model.Date > Model.Today.AddYears(-10)) { <a class="btn btn-outline-secondary" href="/Wellness?date=@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Previous day">Previous</a> }<form method="get"><label for="date">Diary date</label><input field-feedback id="date" name="date" type="date" min="@Model.Today.AddYears(-10).ToString("yyyy-MM-dd")" max="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Date.ToString("yyyy-MM-dd")" required /><button class="btn btn-primary">Go</button></form>@if (Model.Date < Model.Today) { <a class="btn btn-outline-secondary" href="/Wellness?date=@Model.Date.AddDays(1).ToString("yyyy-MM-dd")">Next</a> }<a href="/Wellness">Today</a></section>
<partial name="_DailyMetrics" model="Model" />
<nav class="quick-log-bar" aria-label="Add diary entry">@foreach (var kind in new[] { LogKind.Meal, LogKind.Workout, LogKind.Hydration, LogKind.Sleep, LogKind.Measurement }) { <a asp-controller="Logs" asp-action="Edit" asp-route-kind="@kind" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-returnUrl="@returnUrl">Add @(kind == LogKind.Hydration ? "water" : kind.ToString().ToLowerInvariant())</a> }</nav>
<section class="panel"><div class="panel-heading"><h2>@Model.Date.ToString("dddd, dd MMMM")</h2><span>@Model.Entries.Total entries</span></div>
@if (Model.Entries.Total == 0) { <div class="empty"><h3>No entries on this date</h3><p>Use an add button to start. A blank day means no data, not zero activity.</p></div> }
else { <div class="table-responsive"><table class="diary-table"><thead><tr><th>Time</th><th>Entry</th><th>Recorded values</th><th>Actions</th></tr></thead><tbody>@foreach (var entry in Model.Entries.Items) { <tr><td>@TimeZoneInfo.ConvertTimeBySystemTimeZoneId(entry.OccurredAtUtc, Model.Profile.TimeZoneId).ToString("HH:mm")</td><td><span class="status">@entry.Kind</span><strong>@entry.Description</strong>@if (!string.IsNullOrEmpty(entry.Notes)) { <small class="table-note">@entry.Notes</small> }@if (entry.PlanItemId.HasValue) { <small class="table-note">Linked plan occurrence · @entry.ScheduledDate</small> }</td><td>
@switch (entry.Kind) {
case LogKind.Hydration: <span>@entry.WaterMl ml water</span> break;
case LogKind.Sleep: <span>@(entry.DurationMinutes / 60)h @(entry.DurationMinutes % 60)m</span><small class="table-note">Started @(entry.SleepStartedAtUtc.HasValue ? Display.Local(entry.SleepStartedAtUtc.Value, Model.Profile.TimeZoneId) : "—")</small> break;
case LogKind.Workout: <span>@entry.DurationMinutes min · @entry.Routine</span><small class="table-note">@Display.Number(entry.Calories, " kcal burned")</small> break;
case LogKind.Meal: <span>@Display.Number(entry.Calories, " kcal")</span><small class="table-note">P @Display.Number(entry.Protein, "g") · C @Display.Number(entry.Carbs, "g") · F @Display.Number(entry.Fat, "g")</small> break;
default: <span>@Display.Number(entry.WeightKg, " kg") · @(entry.Steps?.ToString("N0") ?? "—") steps</span><small class="table-note">Height @Display.Number(entry.HeightCm, " cm") · HR @(entry.HeartRate?.ToString() ?? "—") bpm · BP @(entry.Systolic.HasValue ? $"{entry.Systolic}/{entry.Diastolic} mmHg" : "—")</small> break;
}</td><td><div class="diary-actions"><a asp-controller="Logs" asp-action="Edit" asp-route-id="@entry.Id" asp-route-returnUrl="@returnUrl">Edit</a>
@if (entry.Kind is LogKind.Meal or LogKind.Workout) { <a asp-controller="Logs" asp-action="Edit" asp-route-repeatId="@entry.Id" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-returnUrl="@returnUrl">Log again</a><form method="post" asp-action="Favorite"><input type="hidden" name="id" value="@entry.Id" /><input type="hidden" name="version" value="@Display.Version(entry)" /><input type="hidden" name="favorite" value="@(!entry.IsFavorite)" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button class="link-button">@(entry.IsFavorite ? "Unsave" : "Save for reuse")</button></form> }
<form method="post" asp-controller="Logs" asp-action="Delete" data-confirm="Delete this entry? Its totals and any linked plan completion will be updated."><input type="hidden" name="id" value="@entry.Id" /><input type="hidden" name="version" value="@Display.Version(entry)" /><input type="hidden" name="kind" value="@entry.Kind" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button class="link-danger">Delete</button></form></div></td></tr> }</tbody></table></div><partial name="_Pager" model="@((Model.Entries.Number, Model.Entries.Pages))" /> }</section>
<p class="muted">Sleep is counted by wake-up date. Steps use your latest daily total. Unknown nutrition amounts remain unknown. Targets shown here are your current settings, including for past dates.</p>
