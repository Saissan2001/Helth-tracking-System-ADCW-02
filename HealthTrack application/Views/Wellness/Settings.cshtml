@model WellnessSettingsInput
@{ var first = ViewData["FirstRun"] is true; ViewData["Title"] = first ? "Make HealthTrack yours" : "Goals & preferences"; }
<div class="page-heading"><div><h1>@ViewData["Title"]</h1><p>Choose what matters to you. Targets are optional and can be changed any time.</p></div><a href="/Dashboard">@(first ? "Skip for now" : "Back to Today")</a></div>
<section class="panel form-panel wellness-settings"><form method="post"><input type="hidden" asp-for="Version" />
<fieldset><legend>1. Choose your focus</legend><label asp-for="Focus">What would you like to keep in view?</label><select field-feedback asp-for="Focus" asp-items="Html.GetEnumSelectList<WellnessFocus>()"></select><p>Your focus brings relevant metrics forward. It does not create a medical plan.</p></fieldset>
<fieldset><legend>2. Set personal targets, if you want</legend><p>Use targets you choose or agree with your care team. Leave any field blank to track without a target.</p><div class="form-grid"><div><label asp-for="WeeklyWorkoutMinutes">Workout minutes per week</label><input field-feedback asp-for="WeeklyWorkoutMinutes" /></div><div><label asp-for="DailyWaterMl">Water per day (ml)</label><input field-feedback asp-for="DailyWaterMl" /></div><div><label asp-for="NightlySleepMinutes">Sleep per day (minutes)</label><input field-feedback asp-for="NightlySleepMinutes" /><small>For example, 480 minutes is 8 hours. This is a unit example, not a recommended target.</small></div><div><label asp-for="DailySteps">Steps per day</label><input field-feedback asp-for="DailySteps" /></div></div></fieldset>
<fieldset><legend>3. Choose your Today metrics</legend><p>Movement stays visible. Hiding a card keeps its records available in your diary and trends.</p><div class="metric-choices"><label><input asp-for="ShowWater" /> Water</label><label><input asp-for="ShowSleep" /> Sleep</label><label><input asp-for="ShowNutrition" /> Nutrition</label><label><input asp-for="ShowSteps" /> Steps</label></div></fieldset>
<div class="actions"><button class="btn btn-primary">Save my preferences</button><a href="/Dashboard">Cancel</a></div></form></section>
