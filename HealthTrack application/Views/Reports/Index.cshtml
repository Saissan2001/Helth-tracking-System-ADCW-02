@model EngagementReport
@{ ViewData["Title"] = "Performance reports"; var trainer = User.IsInRole(Roles.Trainer); }
<div class="page-heading"><div><h1>Performance & engagement</h1><p>@(trainer ? "Current assigned clients, their recorded activity and routine popularity." : "Aggregate activity and routine popularity across active clients.")</p></div><a class="btn btn-primary" asp-action="Export" asp-route-page="@Model.PageNumber" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">@(trainer ? "Download this page CSV" : "Download aggregate CSV")</a></div>
<section class="panel"><partial name="_DateFilter" /><p class="small muted">Date boundaries use your timezone. Active-day counts use UTC. Cohort membership uses current active accounts and assignments.</p></section>
<div class="stats-grid"><article class="stat"><label>Eligible clients</label><strong>@Model.EligibleClients</strong><small>@(trainer ? "Currently assigned to you" : "Current active client accounts")</small></article><article class="stat"><label>Engaged clients</label><strong>@(Model.Suppressed ? "Hidden" : Model.EngagedClients.ToString())</strong><small>At least one log in this period</small></article><article class="stat"><label>Engagement rate</label><strong>@(Model.Suppressed ? "Hidden" : Model.EngagementPercent.ToString("0.#") + "%")</strong><small>Engaged ÷ eligible clients</small></article><article class="stat"><label>Workout sessions</label><strong>@(Model.Suppressed ? "Hidden" : Model.WorkoutSessions.ToString())</strong><small>Full eligible cohort in this period</small></article></div>
@if (!trainer) { <section class="panel"><h2>Privacy controls</h2><p>Individual client rows are not included in administrator reports. Activity totals are hidden when an engaged group or its complement contains fewer than five clients. The routine breakdown is withheld if any nonempty category has fewer than five participants, preventing subtraction from the total. These controls also apply to CSV downloads; they do not guarantee anonymization against all possible comparisons.</p>@if (Model.Suppressed) { <p role="status">Activity figures are suppressed for this small cohort.</p> }</section> }
@if (trainer) {
<section class="panel"><div class="panel-heading"><h2>Client performance</h2></div><p class="small muted">Counts describe recorded activity. Plan completion is available within each plan. @(trainer ? "Select a client to see their detailed progress." : "Client labels are temporary report labels; health readings, names and notes are excluded.")</p>
@if (Model.Clients.Count == 0) { <p>No eligible clients in this workspace.</p> } else { <div class="table-responsive"><table><thead><tr><th>Client</th><th>Sessions</th><th>Minutes</th><th>Meals</th><th>Measurements</th><th>Active days</th></tr></thead><tbody>@foreach (var c in Model.Clients) { <tr><td>@if (trainer) { <a href="/Progress?clientId=@c.ClientId&from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")">@c.Name</a> } else { @c.Name }</td><td>@c.WorkoutSessions</td><td>@c.WorkoutMinutes</td><td>@c.Meals</td><td>@c.MeasurementEntries</td><td>@c.ActiveDays</td></tr> }</tbody></table></div> }</section>
<partial name="_Pager" model="@((Model.PageNumber, Model.Pages))" /><p class="muted">Up to 20 clients per page. CSV includes this page; summary and routines cover all currently assigned clients. Up to 20,000 workout durations are processed per page.</p>
}
<section class="panel"><h2>Popular workout routines</h2><p class="small muted">Categories are selected when logging workouts and creating schedule items. Published schedule items are counted once per item in plans overlapping this period; they are not completed sessions. Older entries without a category appear as Other.</p>
@if (Model.Routines.Count == 0) { <p>@(Model.Suppressed ? "Routine figures are suppressed for this cohort." : "No routines meet the reporting criteria for this period.")</p> } else { <div class="table-responsive"><table><thead><tr><th>Routine category</th><th>Logged sessions</th><th>Participants</th><th>Published schedule items</th></tr></thead><tbody>@foreach (var r in Model.Routines) { <tr><td>@r.Routine</td><td>@r.LoggedSessions</td><td>@r.UniqueParticipants</td><td>@r.ScheduledItems</td></tr> }</tbody></table></div> }</section>
