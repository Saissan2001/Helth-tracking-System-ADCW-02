@model Page<Notification>
@{ ViewData["Title"] = "Notifications"; }
<div class="page-heading"><div><span class="eyebrow">A GENTLE NUDGE</span><h1>Your inbox</h1><p>Updates and reminders, all in one place. In-app only.</p></div><form method="post" asp-action="Read"><button class="btn btn-outline-secondary">Mark all as read</button></form></div>
<section class="panel">@if (Model.Total == 0) { <div class="empty"><span>♧</span><h2>You're all caught up.</h2><p>Your reminders and updates will appear here when they're due.</p></div> }@foreach (var n in Model.Items) { <article class="notification-row @(n.ReadAtUtc == null ? "unread" : "")"><span class="notification-dot" aria-hidden="true"></span><div><small>@n.Kind · @Display.Local(n.ScheduledAtUtc, (string)ViewData["Zone"]!)</small><h2>@n.Title</h2><span class="muted small">@(n.ReadAtUtc == null ? "Unread" : "Read")</span></div>@if (n.ReadAtUtc == null) { <form method="post" asp-action="Read"><input name="id" type="hidden" value="@n.Id" /><button class="btn btn-outline-secondary btn-sm">Mark read</button></form> }</article> }<partial name="_Pager" model="@((Model.Number, Model.Pages))" /></section>
