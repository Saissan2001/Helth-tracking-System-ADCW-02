@{ Layout = "_HomeLayout"; ViewData["Title"] = "Fitness & health, in your hands"; }
<section class="fitness-hero" aria-labelledby="hero-title">
    <div class="hero-content"><span class="hero-kicker">MOVE WELL. LIVE WELL.</span><h1 id="hero-title">Fitness &<br />Health Tracking</h1><div class="hero-description"><p>Move with purpose. Build a routine that feels like you, with your workouts, nutrition and progress all in one place.</p><a class="orange-button" href="/Account/Register">Get started<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></div><div class="hero-mini-stats"><div><strong>Move</strong><span>Track your workouts</span></div><div><strong>Nourish</strong><span>Know your nutrition</span></div><div><strong>Grow</strong><span>See your progress</span></div></div></div>
    <img class="hero-athlete" src="~/img/home-hero.png" alt="Athlete performing a controlled squat with arms extended" width="1024" height="1536" fetchpriority="high" />
    <span class="hero-caption">YOUR EVERYDAY<br />STARTS WITH YOU.</span>
</section>
<section class="benefit-strip" aria-label="What you can do with HealthTrack">
    <div><img src="~/lib/admin-icons/activity.svg" alt="" /><strong>One healthy routine</strong><p>Your workouts, meals and measurements.<br />All together, all about you.</p></div>
    <div><img src="~/lib/admin-icons/graph-up.svg" alt="" /><strong>Progress you can see</strong><p>Turn your everyday entries into<br />a clearer view of your journey.</p></div>
    <div><img src="~/lib/admin-icons/people-fill.svg" alt="" /><strong>Support that matters</strong><p>Personal plans and feedback<br />from your assigned trainer.</p></div>
</section>
<section class="movement-section section-space" id="movement" aria-labelledby="movement-title">
    <div class="movement-copy"><span class="section-kicker">A LITTLE MORE EVERY DAY</span><h2 id="movement-title">Move to<br />maintain<br />your health.</h2><p>Energize your everyday. Make room for a healthier you with movement, mindful meals, and habits that fit your life.</p><a class="orange-button" href="/Account/Register">Find your rhythm<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a><div class="section-index"><span>01 /</span> YOUR NEXT STEP</div></div>
    <a class="movement-photo" href="/Account/Register"><img src="~/img/home-runner.png" alt="Runner in a lilac shirt building momentum" width="1024" height="1536" loading="lazy" /><span>A brighter future starts<br />with a healthier you.<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></span></a>
    <div class="movement-side"><a class="lime-note" href="#how-it-works" aria-label="Think less, move more — see how to get started">Think less.<br />Move more.<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a><img class="training-photo" src="~/img/home-training.png" alt="Athlete practicing shadowboxing in an outdoor courtyard" width="1024" height="1536" loading="lazy" /></div>
</section>
<section class="objectives-section section-space" id="features" aria-labelledby="objectives-title">
    <span class="section-kicker centered">SMALL STEPS. REAL MOMENTUM.</span><h2 id="objectives-title" class="section-heading centered">Achieve your health<br />objectives in 1–2–3.</h2>
    <div class="objective-grid"><article class="objective-card training-card"><span class="feature-symbol pink"><img src="~/lib/admin-icons/activity.svg" alt="" /></span><span class="feature-number">01</span><h3>Smarter tracking</h3><p>Log your workouts, meals and measurements. Keep the details that matter in one personal space.</p><a href="/Account/Register">Start tracking<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></article>
    <article class="objective-card plans-card"><span class="feature-symbol amber"><img src="~/lib/admin-icons/clipboard2-check.svg" alt="" /></span><span class="feature-number">02</span><h3>A plan for you</h3><p>Follow workout and nutrition plans created by your trainer. Know what's next and keep your routine on track.</p><a href="/Account/Register">Find your direction<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></article>
    <article class="objective-card support-card"><span class="feature-symbol green"><img src="~/lib/admin-icons/people-fill.svg" alt="" /></span><span class="feature-number">03</span><h3>Stronger together</h3><p>Stay connected with your trainer. Share your progress, receive feedback, and make time for a check-in.</p><div class="support-note"><img src="~/lib/admin-icons/calendar3.svg" alt="" /><div><strong>Make time for yourself</strong><span>Book your next appointment</span></div></div><div class="support-note"><img src="~/lib/admin-icons/bell.svg" alt="" /><div><strong>A helpful nudge</strong><span>Your plans and reminders, in one place</span></div></div><a href="/Account/Register">Build your support<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></article></div>
</section>
<section class="insights-section section-space" id="progress" aria-labelledby="insights-title">
    <div class="insights-heading"><span class="section-kicker">MAKE YOUR PROGRESS PERSONAL</span><h2 id="insights-title" class="section-heading">A clearer picture.<br />A healthier perspective.</h2><div class="insights-description"><a class="round-link" href="/Account/Register" aria-label="Get started with personal progress"><img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a><p>See your weight trends, workout activity and nutrition records. Learn from your own progress, one day at a time.</p></div></div>
    <div class="insight-gallery"><figure class="recovery-figure"><img src="~/img/home-recovery.png" alt="Athlete taking a water break after a workout" width="1024" height="1536" loading="lazy" /><figcaption>Movement for your body.<br />Space for your mind.</figcaption></figure><figure class="wellness-figure"><img src="~/img/auth-wellness.png" alt="Woman stretching beside a lake in the morning sunlight" width="1024" height="1536" loading="lazy" /><figcaption>Find a pace that feels like you.</figcaption></figure><figure class="boxing-figure"><img src="~/img/home-training.png" alt="Outdoor strength and conditioning session" width="1024" height="1536" loading="lazy" /><figcaption>Build a little more consistency.</figcaption></figure></div>
</section>
<section class="progress-promo section-space" aria-labelledby="promo-title">
    <div class="promo-copy"><span class="section-kicker">YOUR HEALTH. YOUR SPACE.</span><h2 id="promo-title">Keep your<br />progress<br />close.</h2><p>A personal dashboard for the small things that add up. Ready whenever you are.</p><a class="black-button" href="/Account/Register">Create your account<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a><div class="promo-foot"><img src="~/lib/admin-icons/heart-pulse.svg" alt="" /><span>Workouts. Nutrition. Progress.</span></div></div>
    <div class="promo-image"><img src="~/img/home-stretch.png" alt="Athlete in a gray hoodie stretching outdoors before a workout" width="1536" height="1024" loading="lazy" /><span class="photo-brand"><img src="~/lib/admin-icons/heart-pulse.svg" alt="" />HealthTrack</span><div class="photo-caption"><span>SHOW UP FOR YOURSELF</span><strong>A little today.<br />A stronger tomorrow.</strong></div></div>
</section>
<section class="getting-started section-space" id="how-it-works" aria-labelledby="getting-started-title"><span class="section-kicker centered">NO COMPLICATED START</span><h2 id="getting-started-title" class="section-heading centered">Getting started is<br />simple. Just like that.</h2><div class="start-grid"><article><div class="step-visual step-create"><img class="step-athlete" src="~/img/auth-wellness.png" alt="A quiet morning stretch beside a lake" width="1024" height="1536" loading="lazy" /><span class="step-big-number">01</span><span>YOUR PERSONAL SPACE</span></div><h3>Create your account</h3><p>Sign up with your name and email. Set your preferences and make HealthTrack your own.</p><a class="text-link" href="/Account/Register">Let's get started<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></article><article><div class="step-visual step-move"><img class="step-athlete" src="~/img/home-runner.png" alt="Runner taking the first step" width="1024" height="1536" loading="lazy" /><span class="step-big-number">02</span><span>MAKE YOUR FIRST MOVE</span></div><h3>Make it your everyday</h3><p>Log your first activity, explore your dashboard, and start building a routine that works for you.</p><a class="text-link" href="/Account/Login">Already a member? Sign in<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></article></div></section>
<section class="closing-section section-space" aria-labelledby="closing-title"><h2 id="closing-title" class="section-heading centered">Smarter tracking.<br />A healthier everyday for you.</h2><div class="closing-content"><img class="closing-photo" src="~/img/home-recovery.png" alt="Rest and recovery are part of a balanced routine" width="1024" height="1536" loading="lazy" /><div class="closing-copy"><span class="section-kicker">BODY. MIND. MOMENTUM.</span><h3>One place for<br />your whole routine.</h3><ul><li><img src="~/lib/admin-icons/check-circle.svg" alt="" />Workout and meal logging</li><li><img src="~/lib/admin-icons/check-circle.svg" alt="" />Personal progress charts</li><li><img src="~/lib/admin-icons/check-circle.svg" alt="" />Trainer-created plans and feedback</li><li><img src="~/lib/admin-icons/check-circle.svg" alt="" />Appointments and reminders</li></ul><a class="orange-button" href="/Account/Register">Take your first step<img src="~/lib/admin-icons/arrow-up-right.svg" alt="" /></a></div></div></section>
