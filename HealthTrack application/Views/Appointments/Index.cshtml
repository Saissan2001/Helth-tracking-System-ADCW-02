@model Page<BookingRow>
@{ ViewData["Title"] = "Appointments"; var client = User.IsInRole(Roles.Client); var zone = (string)ViewData["Zone"]!; }
<div class="page-heading"><div><span class="eyebrow">MAKE TIME TO CONNECT</span><h1>Appointments</h1><p>@(client ? "Request a check-in with your trainer or a directory professional." : "Review consultation requests and keep your schedule up to date.")</p></div>@if (client) { <a class="btn btn-primary" asp-action="Create">+ Request appointment</a> }</div>
<div class="notice">Times are shown in @zone. Requests reserve a time while awaiting approval. Directory consultations are coordinated locally by an administrator; no external booking is sent.</div>
@if (Model.Total == 0) { <section class="panel empty"><span>▦</span><h2>Your calendar has room.</h2><p>Appointments will appear here once requested.</p></section> }
@foreach (var row in Model.Items) { var a = row.Appointment; <article class="panel booking-card"><div class="panel-heading"><div><span class="eyebrow">@(a.ProfessionalId.HasValue ? "PROFESSIONAL CONSULTATION" : "TRAINER CHECK-IN")</span><h2>@(client ? row.Provider : row.Client)</h2></div><span class="status status-@a.Status.ToString().ToLowerInvariant()">@a.Status</span></div><div class="booking-meta"><strong>@Display.Local(a.StartsAtUtc, zone)</strong><span>@((a.EndsAtUtc - a.StartsAtUtc).TotalMinutes) minutes · @row.Provider</span></div><p class="preserve-lines">@a.Purpose</p>@if (!string.IsNullOrWhiteSpace(a.ResponseNote)) { <p class="response-note">Coordinator / participant note: @a.ResponseNote</p> }
@if (a.Status is AppointmentStatus.Requested or AppointmentStatus.Confirmed) { <details><summary>Manage this appointment</summary><form method="post" asp-action="Change" feedback-scope="booking-@a.Id-manage"><input name="page" type="hidden" value="@Model.Number" /><input name="editTime" type="hidden" value="false" /><input name="Id" type="hidden" value="@a.Id" /><input name="Version" type="hidden" value="@Display.Version(a)" /><label for="note-@a.Id">Message (optional)</label><input field-feedback id="note-@a.Id" name="Note" maxlength="500" /><div class="actions">
@if (!client && a.Status == AppointmentStatus.Requested) { <button class="btn btn-primary" name="Status" value="Confirmed">Confirm</button><button class="btn btn-outline-secondary" name="Status" value="Declined">Decline</button> }
@if (!client && a.Status == AppointmentStatus.Confirmed && a.EndsAtUtc <= DateTimeOffset.UtcNow) { <button class="btn btn-primary" name="Status" value="Completed">Mark completed</button> }
<button class="btn btn-outline-danger" name="Status" value="Cancelled" data-confirm-button="Cancel this appointment?">Cancel appointment</button></div></form>
@if (client) { <form method="post" asp-action="Change" class="reschedule-form" feedback-scope="booking-@a.Id-time"><input name="page" type="hidden" value="@Model.Number" /><input name="editTime" type="hidden" value="true" /><input name="Id" type="hidden" value="@a.Id" /><input name="Version" type="hidden" value="@Display.Version(a)" /><input name="Status" type="hidden" value="Requested" /><label for="reschedule-@a.Id">Request a different time · @zone</label><input field-feedback id="reschedule-@a.Id" name="RescheduleLocal" type="datetime-local" required /><p class="muted small">The duration stays the same. A confirmed appointment returns to Requested and needs fresh approval.</p><button class="btn btn-secondary">Reschedule for approval</button></form> }
else { <form method="post" asp-action="Change" class="reschedule-form" feedback-scope="booking-@a.Id-time"><input name="page" type="hidden" value="@Model.Number" /><input name="editTime" type="hidden" value="true" /><input name="Id" type="hidden" value="@a.Id" /><input name="Version" type="hidden" value="@Display.Version(a)" /><label for="provider-time-@a.Id">Update time · @zone</label><input field-feedback id="provider-time-@a.Id" name="RescheduleLocal" type="datetime-local" required /><label for="provider-note-@a.Id">Reason for the change</label><input field-feedback id="provider-note-@a.Id" name="Note" maxlength="500" required /><p class="muted small">The duration stays the same. The new time is confirmed and the client receives an in-app notification.</p><button class="btn btn-secondary">Update appointment time</button></form> }</details> }</article> }
<partial name="_Pager" model="@((Model.Number, Model.Pages))" />
