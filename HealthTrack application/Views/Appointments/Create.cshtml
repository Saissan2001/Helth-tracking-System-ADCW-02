@model BookingInput
@{ ViewData["Title"] = "Request a check-in"; var providers = (IReadOnlyList<(string Id, string Name)>)ViewData["Providers"]!; }
<div class="page-heading"><div><span class="eyebrow">A CONVERSATION CAN HELP</span><h1>Request a check-in</h1><p>Choose a provider and a time that works for you.</p></div><a asp-action="Index">All appointments →</a></div><section class="panel form-panel"><form method="post"><label asp-for="Provider">Who would you like to meet?</label><select field-feedback asp-for="Provider" required><option value="">Choose a provider</option>@foreach (var p in providers) { <option value="@p.Id">@p.Name</option> }</select>@if (providers.Count == 0) { <p class="notice">No providers are available. Ask an administrator to assign a trainer or add a directory professional.</p> }<label asp-for="StartsLocal">Start time · @ViewData["Zone"]</label><input field-feedback asp-for="StartsLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" /><label asp-for="DurationMinutes">Duration (15–180 minutes)</label><input field-feedback asp-for="DurationMinutes" min="15" max="180" /><label asp-for="Purpose">What would you like to discuss?</label><textarea field-feedback asp-for="Purpose" rows="3"></textarea><p class="muted small">Share only what is needed to arrange the meeting. Your provider or administrator coordinator can read this note.</p><button class="btn btn-primary">Send appointment request →</button></form></section>
