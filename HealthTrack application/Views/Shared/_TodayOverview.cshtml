@model DailyOverview
<section class="today-intro"><div><span class="section-kicker">TODAY · @Model.Date.ToString("ddd, dd MMM")</span><h2>Make room for your wellbeing.</h2><p>Your daily activity, rest and nutrition in one place. Every number comes from your own entries.</p></div><a class="btn btn-outline-secondary" href="/Wellness/Settings">Customize Today</a></section>
@if (Model.Preferences.SetupCompletedAtUtc == null) {
    <section class="onboarding-card"><div><span class="section-kicker">START AT YOUR OWN PACE</span><h2>A dashboard that fits your day</h2><p>Choose your focus, set optional personal targets, and decide which metrics you want to see.</p></div><a class="btn btn-primary" href="/Wellness/Settings">Set up my overview</a><ol class="setup-steps"><li>Choose your focus</li><li>Record your first entry</li><li>Review your week</li></ol></section>
}
<partial name="_DailyMetrics" model="Model" />
<nav class="quick-log-bar" aria-label="Quick logging"><a href="/Logs/Edit?kind=Workout&returnUrl=/Dashboard"><img src="~/lib/admin-icons/activity.svg" alt="" />Workout</a><a href="/Logs/Edit?kind=Meal&returnUrl=/Dashboard"><img src="~/lib/admin-icons/basket2.svg" alt="" />Meal</a><a href="/Logs/Edit?kind=Hydration&returnUrl=/Dashboard"><img src="~/lib/admin-icons/heart-pulse.svg" alt="" />Water</a><a href="/Logs/Edit?kind=Sleep&returnUrl=/Dashboard"><img src="~/lib/admin-icons/calendar3.svg" alt="" />Sleep</a><a href="/Logs/Edit?kind=Measurement&returnUrl=/Dashboard"><img src="~/lib/admin-icons/graph-up.svg" alt="" />Measurement</a></nav>
<div class="today-columns"><section class="panel"><div class="panel-heading"><h2>Your daily diary</h2><a href="/Wellness">Open diary</a></div>
@if (Model.Entries.Total == 0) { <div class="empty compact"><h3>Start with one small entry</h3><p>Record water, a meal, movement or sleep. Missing data stays clearly marked.</p></div> }
else { <ul class="activity-timeline">@foreach (var entry in Model.Entries.Items.Take(5)) { <li><span class="timeline-kind">@entry.Kind</span><div><a href="/Logs/Edit/@entry.Id?returnUrl=/Dashboard">@entry.Description</a><small>@Display.Local(entry.OccurredAtUtc, Model.Profile.TimeZoneId)</small></div><a href="/Logs/Edit/@entry.Id?returnUrl=/Dashboard" aria-label="Edit @entry.Description">Edit</a></li> }</ul><p class="muted">@Model.Entries.Total entries today · <a href="/Wellness">See all entries</a></p> }</section>
<section class="panel"><div class="panel-heading"><h2>Your week, in perspective</h2><a href="/Wellness/Trends">See trends</a></div><div class="consistency-week">@foreach (var day in Model.Days) { <a class="@(day.Entries > 0 ? "has-entries" : "")" href="/Wellness?date=@day.Date.ToString("yyyy-MM-dd")" aria-label="@day.Date.ToString("dd MMM"): @day.Entries entries"><span>@day.Date.ToString("ddd").Substring(0, 1)</span><strong>@day.Date.Day</strong></a> }</div><h3>@Model.RecordedDays of 7 days recorded</h3><p>@Model.SevenWorkoutMinutes workout minutes in the last seven days. Previous seven: @Model.PreviousSevenMinutes minutes.</p><small>Logging consistency describes your records, not your health or effort on unrecorded days.</small></section></div>
<section class="panel"><div class="panel-heading"><h2>On your schedule today</h2><a href="/Plans">All plans</a></div>
@if (Model.Schedule.Count == 0) { <p>No scheduled workout or meal today. You can still record your own activity.</p> }
else { <ul class="today-schedule">@foreach (var item in Model.Schedule) { <li><time>@item.Time.ToString("HH:mm")</time><div><strong>@item.Description</strong><small>@item.Title · @item.Kind</small></div>@if (item.LogId.HasValue) { <a href="/Logs/Edit/@item.LogId?returnUrl=/Dashboard">Recorded · review</a> } else { <a href="/Logs/Edit?itemId=@item.ItemId&date=@Model.Date.ToString("yyyy-MM-dd")&returnUrl=/Dashboard">Record actual entry</a> }</li> }</ul>@if (Model.ScheduledCount > Model.Schedule.Count) { <p>Showing @Model.Schedule.Count of @Model.ScheduledCount items. Open your plans for the full schedule.</p> } }</section>

@if (Model.Favorites.Count > 0) {
<section class="panel"><div class="panel-heading"><h2>Your saved shortcuts</h2><a href="/Wellness/Library">Saved entries</a></div><ul class="activity-timeline">
@foreach (var entry in Model.Favorites) { <li><span class="timeline-kind">@entry.Kind</span><div><strong>@entry.Description</strong><small>Review amounts and time before recording</small></div><a asp-controller="Logs" asp-action="Edit" asp-route-repeatId="@entry.Id" asp-route-returnUrl="/Dashboard">Log again</a></li> }
</ul></section>
}
