@model ProgressReport
<div class="stats-grid"><article class="stat"><label>Latest weight in range</label><strong>@Display.Number(Model.Weight, " kg")</strong><small>BMI @Display.Number(Model.Bmi)</small></article><article class="stat"><label>Workouts</label><strong>@Model.WorkoutCount</strong><small>@Model.WorkoutMinutes minutes logged</small></article><article class="stat"><label>Calories burned</label><strong>@Display.Number(Model.Burned, " kcal")</strong><small>Known values only</small></article><article class="stat"><label>Energy consumed</label><strong>@Display.Number(Model.Eaten, " kcal")</strong><small>Actual meals logged, known values only</small></article></div>
<section class="panel"><div class="panel-heading"><h2>Weight over time</h2><span class="pill">KILOGRAMS</span></div>@if (Model.WeightPoints.Count == 0) { <div class="empty"><p>No weight measurements in this range.</p></div> } else { <div class="chart-wrap"><canvas class="weight-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.WeightPoints)" role="img" aria-label="Weight trend; corresponding readings are in the table below"></canvas></div><details><summary>View weight data (@Model.WeightPoints.Count most recent readings, up to 366)</summary><div class="table-responsive"><table><thead><tr><th>Measured at (UTC)</th><th>Weight (kg)</th><th>BMI</th></tr></thead><tbody>@foreach (var point in Model.WeightPoints) { <tr><td>@point.At.UtcDateTime.ToString("dd MMM yyyy HH:mm")</td><td>@point.Weight.ToString("0.##")</td><td>@Display.Number(point.Bmi)</td></tr> }</tbody></table></div></details> }</section>
<section class="panel"><h2>Daily activity</h2><p class="muted">Days are grouped by UTC. Only logged values count; unknown calories are excluded from totals. BMI uses the most recent height at or before the weight reading.</p>@if (Model.Days.Count == 0) { <div class="empty compact"><p>No workouts or meals recorded in this range.</p></div> } else { <div class="chart-wrap"><canvas class="activity-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Days)" role="img" aria-label="Daily energy intake and expenditure, with values in the table below"></canvas></div><details><summary>View daily totals</summary><div class="table-responsive"><table><thead><tr><th>Date (UTC)</th><th>Workouts</th><th>Known calories burned (kcal)</th><th>Known energy consumed (kcal)</th></tr></thead><tbody>@foreach (var day in Model.Days) { <tr><td>@day.Day.ToString("dd MMM yyyy")</td><td>@day.Workouts</td><td>@day.Burned</td><td>@day.Eaten</td></tr> }</tbody></table></div></details> }</section>

<section class="panel"><div class="panel-heading"><h2>BMI over time</h2><span class="pill">CALCULATED, NOT A DIAGNOSIS</span></div>@if (Model.WeightPoints.Any(x => x.Bmi.HasValue)) { <div class="chart-wrap"><canvas class="bmi-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.WeightPoints)" role="img" aria-label="BMI trend; values are in the weight data table above"></canvas></div> } else { <p class="muted">Record both weight and a relevant height to see a BMI trend.</p> }</section>
<section class="panel"><h2>Weekly movement</h2><p class="muted">Weeks start on Monday (UTC). Counts describe logged sessions, not proof of prescribed-plan completion.</p>@if (Model.Weeks.Count == 0) { <p>No activity in the selected range.</p> } else { <div class="chart-wrap"><canvas class="weekly-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Weeks)" role="img" aria-label="Weekly workout minutes, with counts and durations in the table below"></canvas></div><details><summary>View weekly totals</summary><table><thead><tr><th>Week starting</th><th>Sessions</th><th>Minutes</th></tr></thead><tbody>@foreach (var week in Model.Weeks) { <tr><td>@week.Starting.ToString("dd MMM yyyy")</td><td>@week.Workouts</td><td>@week.Minutes</td></tr> }</tbody></table></details> }</section>
