@{ var publicPage = ViewContext.RouteData.Values["action"]?.ToString(); }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Build a healthier routine with HealthTrack. Track workouts and meals, follow trainer-created plans, and see your personal progress in one place." />
    <title>@ViewData["Title"] · HealthTrack</title>
    <link rel="preload" href="~/fonts/Manrope-variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @if (publicPage == "Index")
    {
        <link rel="stylesheet" href="~/css/home-landing.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/feedback.css" asp-append-version="true" />
</head>
<body class="home-body @(publicPage == "Index" ? "home-landing" : "")">
    <a class="home-skip" href="#main">Skip to content</a>
    <div class="home-frame">
        <header class="home-header">
            <a class="home-brand" href="/" aria-label="HealthTrack home"><img src="~/lib/admin-icons/heart-pulse.svg" width="25" height="25" alt="" />HealthTrack</a>
            <button class="home-menu-toggle" type="button" aria-label="Open navigation" aria-controls="home-navigation" aria-expanded="false"><img src="~/lib/admin-icons/list.svg" width="22" height="22" alt="" /></button>
            <nav id="home-navigation" class="home-nav" aria-label="Main navigation"><a class="@(publicPage == "Index" ? "current" : "")" href="/">Home</a><a href="/#features">Features</a><a href="/#how-it-works">How it works</a><a class="@(publicPage == "About" ? "current" : "")" href="/Home/About">About</a><a class="@(publicPage == "Contact" ? "current" : "")" href="/Home/Contact">Contact us</a></nav>
            <a class="home-signin" href="/Account/Login">Sign in<img src="~/lib/admin-icons/arrow-up-right.svg" width="14" height="14" alt="" /></a>
        </header>
        <main id="main">@RenderBody()</main>
        <footer class="home-footer">
            <div class="footer-top"><div><a class="home-brand" href="/" aria-label="HealthTrack home"><img src="~/lib/admin-icons/heart-pulse.svg" width="25" height="25" alt="" />HealthTrack</a><p>A little movement.<br />A healthier every day.</p></div><div><span class="footer-label">Your next chapter starts here</span><a class="footer-invite" href="/Account/Register">Let's get moving.<img src="~/lib/admin-icons/arrow-up-right.svg" width="26" height="26" alt="" /></a></div></div>
            <nav class="footer-links" aria-label="Footer navigation"><a href="/">Home</a><a href="/#movement">Training</a><a href="/#features">Features</a><a href="/Home/About">About us</a><a href="/Home/Contact">Contact us</a><a href="/Account/Login">Sign in</a></nav>
            <div class="footer-bottom"><span>© @DateTime.UtcNow.Year HealthTrack</span><a href="/Home/Privacy">Privacy policy</a><a href="/Home/Terms">Terms & conditions</a><span>Built for your everyday progress.</span></div>
        </footer>
    </div>
    <script src="~/js/home.js" asp-append-version="true"></script>
<partial name="_Toasts" />
<script src="~/js/feedback.js" asp-append-version="true"></script>
</body>
</html>
