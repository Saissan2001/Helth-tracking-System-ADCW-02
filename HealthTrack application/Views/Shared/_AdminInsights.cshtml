@model AdminInsights
<section class="panel"><h2>Account registrations</h2><p class="muted">Accounts created in the selected period, grouped by UTC day. Includes accounts now inactive.</p><div class="chart-wrap"><canvas class="registration-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Registrations)" role="img" aria-label="Daily registrations; exact counts in the following table"></canvas></div><details><summary>View registration counts</summary><table><thead><tr><th>Day (UTC)</th><th>Registrations</th></tr></thead><tbody>@foreach (var d in Model.Registrations) { <tr><td>@d.Day.ToString("dd MMM yyyy")</td><td>@d.Entries</td></tr> }</tbody></table></details></section>
<section class="panel"><h2>Trainer workload</h2><p class="muted">Current active assignments per active trainer. Showing @Model.Workloads.Items.Count of @Model.Workloads.Total trainers, highest workload first.</p>
@if (Model.Workloads.Total == 0) { <p>No active trainers yet.</p> }
else { <div class="chart-wrap"><canvas class="workload-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Workloads.Items)" role="img" aria-label="Trainer assignments; exact counts in the following table"></canvas></div><table><thead><tr><th>Trainer</th><th>Assigned clients</th></tr></thead><tbody>@foreach (var row in Model.Workloads.Items) { <tr><td>@row.Name</td><td>@row.Clients</td></tr> }</tbody></table> }</section>
