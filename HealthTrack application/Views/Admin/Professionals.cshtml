@model IReadOnlyList<HealthcareProfessional>
@{ ViewData["Title"] = "Professional directory"; }
<div class="page-heading"><div><span class="eyebrow">MORE WAYS TO CONNECT</span><h1>Professional directory</h1><p>Managed booking resources. These professionals do not have app login accounts.</p></div></div>
<section class="panel form-panel"><h2>Add a professional</h2><form method="post" asp-action="Professional" feedback-scope="professional-new"><input name="IsActive" type="hidden" value="true" /><label for="DisplayName">Display name</label><input field-feedback id="DisplayName" name="DisplayName" maxlength="100" required /><label for="Specialty">Specialty</label><input field-feedback id="Specialty" name="Specialty" maxlength="100" required /><label for="Organization">Organization (optional)</label><input field-feedback id="Organization" name="Organization" maxlength="150" /><button class="btn btn-primary">Add professional</button></form></section>
<div class="feature-grid">@foreach (var p in Model) { <article class="panel"><div class="panel-heading"><h2>@p.DisplayName</h2><span class="status">@(p.IsActive ? "Available" : "Inactive")</span></div><p>@p.Specialty · @p.Organization</p><details><summary>Edit directory entry</summary><form method="post" asp-action="Professional" feedback-scope="professional-@p.Id"><input name="Id" type="hidden" value="@p.Id" /><input name="Version" type="hidden" value="@Display.Version(p)" /><label for="name-@p.Id">Name</label><input field-feedback id="name-@p.Id" name="DisplayName" value="@p.DisplayName" maxlength="100" required /><label for="specialty-@p.Id">Specialty</label><input field-feedback id="specialty-@p.Id" name="Specialty" value="@p.Specialty" maxlength="100" required /><label for="org-@p.Id">Organization</label><input field-feedback id="org-@p.Id" name="Organization" value="@p.Organization" maxlength="150" /><label class="check"><input field-feedback name="IsActive" type="checkbox" value="true" checked="@p.IsActive" /> Available for bookings</label><input name="IsActive" type="hidden" value="false" /><small>Deactivation cancels pending and confirmed consultations.</small><button class="btn btn-secondary">Save changes</button></form></details></article> }</div>
