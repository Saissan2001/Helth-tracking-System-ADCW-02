@model Page<MemberProfile>
@{ ViewData["Title"] = "People"; }
<div class="page-heading"><div><span class="eyebrow">YOUR HEALTHTRACK COMMUNITY</span><h1>People</h1><p>Manage accounts and help everyone find their place.</p></div><a class="btn btn-primary" href="/Account/CreateTrainer">+ Create trainer</a></div>
<section class="panel"><form method="get" class="filters"><div><label for="search">Search by name</label><input field-feedback id="search" name="search" value="@ViewData["Search"]" /></div><div><label for="role">Account role</label><select field-feedback id="role" name="role"><option value="">All roles</option>@foreach (var role in new[] { Roles.Client, Roles.Trainer, Roles.Administrator }) { <option value="@role" selected="@(role == (string?)ViewData["Role"])">@role</option> }</select></div><button class="btn btn-secondary">Find people</button></form><div class="table-responsive"><table><thead><tr><th>Name</th><th>Role</th><th>Status</th><th>Joined</th><th>Manage</th></tr></thead><tbody>@foreach (var person in Model.Items) { <tr><td><strong>@person.DisplayName</strong></td><td>@person.Role</td><td><span class="status">@(person.IsActive ? "Active" : "Disabled")</span></td><td>@person.CreatedAtUtc.ToString("dd MMM yyyy")</td><td>@if (person.Role != Roles.Administrator) { <form method="post" asp-action="SetActive" data-confirm="Change this account's access? Disabling also ends assignments and cancels pending bookings."><input name="userId" type="hidden" value="@person.UserId" /><input name="active" type="hidden" value="@((!person.IsActive).ToString())" /><button class="@(person.IsActive ? "link-danger" : "link-button")">@(person.IsActive ? "Disable account" : "Reactivate")</button></form> }</td></tr> }</tbody></table></div>@if (Model.Total == 0) { <div class="empty"><p>No accounts match your search.</p></div> }<partial name="_Pager" model="@((Model.Number, Model.Pages))" /></section>
