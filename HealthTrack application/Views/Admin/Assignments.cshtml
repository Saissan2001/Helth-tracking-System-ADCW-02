@model IReadOnlyList<AssignmentRow>
@{ ViewData["Title"] = "Trainer assignments"; var clients = (Page<MemberProfile>)ViewData["Clients"]!; var trainers = (Page<MemberProfile>)ViewData["Trainers"]!; }
<div class="page-heading"><div><span class="eyebrow">THE RIGHT SUPPORT</span><h1>Trainer assignments</h1><p>One active trainer per client. Transfers preserve the assignment history.</p></div></div>
<section class="panel"><h2>Assign or transfer a client</h2><form method="get" class="filters"><div><label for="search">Find client by name</label><input field-feedback id="search" name="search" value="@ViewData["Search"]" /></div><div><label for="trainerSearch">Find trainer by name</label><input field-feedback id="trainerSearch" name="trainerSearch" value="@ViewData["TrainerSearch"]" /></div><button class="btn btn-secondary">Search people</button></form><form method="post" asp-action="Assign" class="filters"><div><label for="clientId">Client</label><select field-feedback id="clientId" name="clientId" required><option value="">Select client</option>@foreach (var p in clients.Items.Where(x => x.IsActive)) { <option value="@p.UserId">@p.DisplayName</option> }</select></div><div><label for="trainerId">Trainer</label><select field-feedback id="trainerId" name="trainerId" required><option value="">Select trainer</option>@foreach (var p in trainers.Items.Where(x => x.IsActive)) { <option value="@p.UserId">@p.DisplayName</option> }</select></div><button class="btn btn-primary">Save assignment</button></form><p class="muted small">Transferring ends the old trainer's access immediately and cancels their pending consultations. Published plans remain with the client as a record of their guidance.</p><partial name="_Pager" model="@((clients.Number, clients.Pages))" /><div class="pager"><span>Trainer page @trainers.Number of @trainers.Pages</span>@if (trainers.Number > 1) { <a asp-route-search="@ViewData["Search"]" asp-route-trainerSearch="@ViewData["TrainerSearch"]" asp-route-trainerPage="@(trainers.Number - 1)">Previous trainers</a> } @if (trainers.Number < trainers.Pages) { <a asp-route-search="@ViewData["Search"]" asp-route-trainerSearch="@ViewData["TrainerSearch"]" asp-route-trainerPage="@(trainers.Number + 1)">More trainers</a> }</div></section>
<section class="panel"><h2>Assignment history</h2><p class="muted small">Most recent 200 assignments.</p><div class="table-responsive"><table><thead><tr><th>Client</th><th>Trainer</th><th>Assigned</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var row in Model) { <tr><td>@row.Client</td><td>@row.Trainer</td><td>@row.Assignment.AssignedAtUtc.ToString("dd MMM yyyy")</td><td><span class="status">@(row.Assignment.EndedAtUtc.HasValue ? "Ended" : "Active")</span></td><td>@if (!row.Assignment.EndedAtUtc.HasValue) { <form method="post" asp-action="Revoke" data-confirm="End this assignment and revoke trainer access? Pending consultations will be cancelled."><input name="id" type="hidden" value="@row.Assignment.Id" /><input name="version" type="hidden" value="@Display.Version(row.Assignment)" /><button class="link-danger">End assignment</button></form> }</td></tr> }</tbody></table></div>@if (Model.Count == 0) { <div class="empty"><p>No assignments yet.</p></div> }</section>

