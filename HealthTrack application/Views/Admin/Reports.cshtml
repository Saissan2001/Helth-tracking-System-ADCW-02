@model AdminReport
@{ ViewData["Title"] = "Reports & audit"; }
<div class="page-heading"><div><span class="eyebrow">A CLEARER VIEW</span><h1>Reports & audit</h1><p>Aggregate usage and administrative activity. Individual health readings remain private.</p></div></div><section class="panel"><partial name="_DateFilter" /></section>
<div class="stats-grid"><article class="stat"><label>Active accounts · all time</label><strong>@Model.ActiveUsers</strong><small>@Model.Clients clients / @Model.Trainers trainers in total</small></article><article class="stat"><label>Current assignments</label><strong>@Model.ActiveAssignments</strong><small>Active trainer–client relationships</small></article><article class="stat"><label>Logs in selected period</label><strong>@Model.Logs</strong><small>Measurements, workouts and meals</small></article><article class="stat"><label>Plans · all time</label><strong>@Model.Plans</strong><small>All lifecycle statuses</small></article></div>
<section class="panel"><h2>Appointments in the selected period</h2><div class="status-counts">@foreach (var status in Enum.GetValues<AppointmentStatus>()) { <div><span class="status">@status</span><strong>@Model.Appointments.GetValueOrDefault(status)</strong></div> }</div></section>
<section class="panel"><h2>Community activity</h2><p class="muted">Total health-log entries per day, grouped by UTC. No individual values are included.</p>@if (Model.Usage.Count == 0) { <p>No activity in this range.</p> } else { <div class="chart-wrap"><canvas class="usage-chart" data-points="@System.Text.Json.JsonSerializer.Serialize(Model.Usage)" role="img" aria-label="Daily usage with data table below"></canvas></div><details><summary>View daily entry counts</summary><table><thead><tr><th>Day (UTC)</th><th>Entries</th></tr></thead><tbody>@foreach (var d in Model.Usage) { <tr><td>@d.Day.ToString("dd MMM yyyy")</td><td>@d.Entries</td></tr> }</tbody></table></details> }</section>
<section class="panel"><h2>Activity audit</h2><p class="muted">Most recent 100 events in the selected period. Health notes, passwords and tokens are excluded.</p><div class="table-responsive"><table><thead><tr><th>When (UTC)</th><th>Action</th><th>Actor reference</th><th>Resource reference</th></tr></thead><tbody>@foreach (var entry in Model.Audit) { <tr><td>@entry.OccurredAtUtc.UtcDateTime.ToString("dd MMM yyyy HH:mm")</td><td>@entry.Action</td><td class="mono">@entry.ActorId</td><td class="mono">@entry.ResourceId</td></tr> }</tbody></table></div></section>

@if (Model.Insights != null) { <partial name="_AdminInsights" model="Model.Insights" /><partial name="_Pager" model="@((Model.Insights.Workloads.Number, Model.Insights.Workloads.Pages))" /> }
