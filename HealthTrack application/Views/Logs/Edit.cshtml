@model LogInput
@{ ViewData["Title"] = (Model.Id.HasValue ? "Edit " : "Record ") + Model.Kind.ToString().ToLowerInvariant(); var backUrl = ViewData["ReturnUrl"] as string ?? Url.Action("Index", "Logs", new { kind = Model.Kind }); }
<div class="page-heading"><div><span class="eyebrow">A SMALL STEP FORWARD</span><h1>@ViewData["Title"]</h1><p>Record your own values. Leave optional measurements blank if unknown.</p></div><a href="@backUrl">Back to entries →</a></div>
@if (Model.PlanItemId.HasValue) { <section class="panel"><strong>Linked to your plan · @Model.ScheduledDate?.ToString("dd MMM yyyy")</strong><p>Enter the actual time and amounts. Saving this entry records completion of this scheduled item; deleting it removes completion.</p></section> }
@if (ViewData["Repeated"] is true) { <section class="panel"><strong>Review before logging again</strong><p>This is an editable copy of a previous entry. Check the time, portion or duration, and amounts before saving. It does not complete a scheduled plan item automatically.</p></section> }
<section class="panel form-panel"><form method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="Kind" type="hidden" /><input asp-for="PlanItemId" type="hidden" /><input asp-for="ScheduledDate" type="hidden" />
<label asp-for="Description">@(Model.Kind == LogKind.Meal ? "Meal type and food" : "Entry title")</label><input field-feedback asp-for="Description" placeholder="@(Model.Kind == LogKind.Meal ? "Lunch · rice, lentils and vegetables" : Model.Kind == LogKind.Workout ? "Morning walk" : "Morning check-in")" />
@if (Model.Kind == LogKind.Sleep) { <label asp-for="SleepStartedLocal">Sleep started · @ViewData["Zone"]</label><input field-feedback asp-for="SleepStartedLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required /><p class="muted">Duration is calculated from the times you enter. Sleep is grouped under its wake-up date; overlapping sessions are not allowed.</p> }
<label asp-for="LocalTime">@(Model.Kind == LogKind.Sleep ? "Woke up" : "Date and time") · @ViewData["Zone"]</label><input field-feedback asp-for="LocalTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
<div class="form-grid">
@if (Model.Kind == LogKind.Measurement) {
<div><label asp-for="WeightKg">Weight (kg)</label><input field-feedback asp-for="WeightKg" step="0.01" /></div><div><label asp-for="HeightCm">Height (cm)</label><input field-feedback asp-for="HeightCm" step="0.1" /></div><div><label asp-for="HeartRate">Resting heart rate (bpm)</label><input field-feedback asp-for="HeartRate" /></div><div><label asp-for="Steps">Steps</label><input field-feedback asp-for="Steps" /></div><div><label asp-for="Systolic">Systolic pressure (mmHg)</label><input field-feedback asp-for="Systolic" /></div><div><label asp-for="Diastolic">Diastolic pressure (mmHg)</label><input field-feedback asp-for="Diastolic" /></div>
} else if (Model.Kind == LogKind.Hydration) {
<div><label asp-for="WaterMl">Water (ml)</label><input field-feedback asp-for="WaterMl" type="number" min="1" max="10000" required /><div class="water-presets" aria-label="Fill water amount">@foreach (var amount in new[] { 250, 500, 750 }) { <button type="button" class="btn btn-outline-secondary" data-water-amount="@amount">@amount ml</button> }</div><small>Choose a quick amount or enter your own. The entry is saved only when you select Save entry.</small></div>
} else if (Model.Kind != LogKind.Sleep) {
@if (Model.Kind == LogKind.Workout) { <div><label asp-for="Routine">Routine category</label><select field-feedback asp-for="Routine" asp-items="Html.GetEnumSelectList<WorkoutRoutine>()"></select></div><div><label asp-for="DurationMinutes">Duration (minutes)</label><input field-feedback asp-for="DurationMinutes" required /></div> }
<div><label asp-for="Calories">@(Model.Kind == LogKind.Workout ? "Calories burned" : "Energy consumed") (kcal)</label><input field-feedback asp-for="Calories" step="0.1" /></div>
@if (Model.Kind == LogKind.Meal) { <div><label asp-for="Protein">Protein (g)</label><input field-feedback asp-for="Protein" step="0.1" /></div><div><label asp-for="Carbs">Carbohydrates (g)</label><input field-feedback asp-for="Carbs" step="0.1" /></div><div><label asp-for="Fat">Fat (g)</label><input field-feedback asp-for="Fat" step="0.1" /></div> }
}</div><label asp-for="Notes">Notes (optional)</label><textarea field-feedback asp-for="Notes" rows="3"></textarea><div class="actions"><button class="btn btn-primary">Save entry</button><a class="btn btn-outline-secondary" href="@backUrl">Cancel</a></div></form></section>
