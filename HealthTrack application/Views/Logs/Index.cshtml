@model Page<HealthLog>
@{ var kind = (LogKind)ViewData["Kind"]!; ViewData["Title"] = kind == LogKind.Meal ? "Nutrition" : kind == LogKind.Workout ? "Workouts" : kind == LogKind.Hydration ? "Hydration" : kind == LogKind.Sleep ? "Sleep" : "Measurements"; }
<div class="page-heading"><div><span class="eyebrow">YOUR DAILY RECORD</span><h1>@ViewData["Title"]</h1><p>@(kind == LogKind.Meal ? "A record of what you actually ate. Every entry is your own." : kind == LogKind.Workout ? "Make your movement count, one session at a time." : "Check in with yourself and see how things change.")</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-kind="@kind">+ Add @kind.ToString().ToLowerInvariant()</a></div>
<section class="panel"><partial name="_DateFilter" /><p class="muted small">@Model.Total entries · Times in @ViewData["Zone"]. Calories are self-reported; “—” means not supplied.</p>
@if (Model.Total == 0) { <div class="empty"><span>✦</span><h2>A fresh start.</h2><p>No entries in this date range. Add one when you're ready.</p></div> }
else { <div class="table-responsive"><table><thead><tr><th>When</th><th>Entry</th><th>@(kind == LogKind.Measurement ? "Readings" : "Recorded values")</th><th>Actions</th></tr></thead><tbody>@foreach (var log in Model.Items) { <tr><td>@Display.Local(log.OccurredAtUtc, (string)ViewData["Zone"]!)</td><td><strong>@log.Description</strong><small class="table-note">@log.Notes</small></td><td>@if (kind == LogKind.Measurement) { <span>@(log.WeightKg?.ToString("0.#") ?? "—") kg / @(log.HeightCm?.ToString("0.#") ?? "—") cm</span><small class="table-note">HR @(log.HeartRate?.ToString() ?? "—") bpm · BP @(log.Systolic?.ToString() ?? "—")/@(log.Diastolic?.ToString() ?? "—") · @(log.Steps?.ToString() ?? "—") steps</small> } else if (kind == LogKind.Hydration) { <span>@log.WaterMl ml water</span> } else if (kind == LogKind.Sleep) { <span>@log.DurationMinutes minutes asleep</span> } else { <span>@(kind == LogKind.Workout ? log.DurationMinutes + " min · " : "")@(log.Calories?.ToString("0.#") ?? "—") kcal</span>@if (kind == LogKind.Meal) { <small class="table-note">P @(log.Protein?.ToString() ?? "—") / C @(log.Carbs?.ToString() ?? "—") / F @(log.Fat?.ToString() ?? "—") g</small> } }</td><td><div class="actions"><a asp-action="Edit" asp-route-id="@log.Id">Edit</a>@if (kind is LogKind.Meal or LogKind.Workout) { <a asp-action="Edit" asp-route-repeatId="@log.Id">Log again</a><form method="post" asp-controller="Wellness" asp-action="Favorite"><input type="hidden" name="id" value="@log.Id" /><input type="hidden" name="version" value="@Display.Version(log)" /><input type="hidden" name="favorite" value="@(!log.IsFavorite)" /><input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><button class="link-button">@(log.IsFavorite ? "Unsave" : "Save for reuse")</button></form> }<form method="post" asp-action="Delete" data-confirm="Delete this entry? Your report totals will be recalculated."><input name="id" type="hidden" value="@log.Id" /><input name="kind" type="hidden" value="@kind" /><input name="version" type="hidden" value="@Display.Version(log)" /><button class="link-danger">Delete</button></form></div></td></tr> }</tbody></table></div> }
<partial name="_Pager" model="@((Model.Number, Model.Pages))" /></section>
